generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Outcome {
  MEMORIZED
  NOT_MEMORIZED
  ABSENT
}
enum RecitationKind {
  MEMORIZATION
  REVIEW
}
model Teacher {
  id String @id @default(cuid())
  name String
  codeLookup String @unique
  codeHash String
  halqas Halqa[]
  sessions TeacherSession[]
}
model TeacherSession {
  id String @id
  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model LoginBucket {
  key String @id
  attempts Int @default(0)
  expiresAt DateTime
}
model Halqa {
  id String @id @default(cuid())
  name String
  attendanceOnly Boolean @default(false)
  attendanceStartsOn DateTime? @db.Date
  attendanceEdits AttendanceEdit[]
  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  days DailySession[]
  @@index([teacherId])
}
model Student {
  id String @id @default(cuid())
  name String
  enrollments Enrollment[]
}
model Enrollment {
  id String @id @default(cuid())
  studentId String
  halqaId String
  student Student @relation(fields: [studentId], references: [id])
  halqa Halqa @relation(fields: [halqaId], references: [id])
  active Boolean @default(true)
  reviewOnly Boolean @default(false)
  position Int @default(0)
  dailyStatuses DailyStudentStatus[]
  assignments Assignment[]
  memorizationSequence MemorizationSequence?
  @@unique([studentId, halqaId])
  @@unique([id, halqaId])
  @@index([halqaId, active])
}
model DailySession {
  id String @id @default(cuid())
  halqaId String
  date DateTime @db.Date
  halqa Halqa @relation(fields: [halqaId], references: [id])
  closedAt DateTime?
  attendanceConfirmedAt DateTime?
  attendanceRecordedBy String?
  statuses DailyStudentStatus[]
  @@unique([halqaId, date])
  @@unique([id, halqaId])
}
model DailyStudentStatus {
  id String @id @default(cuid())
  sessionId String
  enrollmentId String
  halqaId String
  session DailySession @relation(fields: [sessionId, halqaId], references: [id, halqaId])
  enrollment Enrollment @relation(fields: [enrollmentId, halqaId], references: [id, halqaId])
  outcome Outcome?
  attendance String?
  // Snapshot the study track so later enrollment changes do not rewrite history.
  reviewOnly Boolean @default(false)
  memorizationResult String?
  reviewResult String?
  note String @default("")
  updatedAt DateTime @updatedAt
  entries RecitationEntry[]
  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId, halqaId])
}

model AttendanceEdit {
  id String @id @default(cuid())
  halqaId String
  halqa Halqa @relation(fields: [halqaId], references: [id])
  date DateTime @db.Date
  actorKind String
  actorId String
  actorName String
  requestKey String @unique
  payloadHash String
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([halqaId, date, createdAt])
}
enum RangeDirection {
  FORWARD
  REVERSE
}
model RecitationEntry {
  // Teacher correction for progression; assessment retains the original attempt result.
  masteryResult String?
  direction RangeDirection @default(FORWARD)
  id String @id @default(cuid())
  dailyStatusId String
  dailyStatus DailyStudentStatus @relation(fields: [dailyStatusId], references: [id])
  kind RecitationKind
  assessment String?
  startSurah Int
  startAyah Int
  endSurah Int
  endAyah Int
  createdAt DateTime @default(now())
  // Set only once a validated Madani 604-page mapping is supplied.
  pageAmount Decimal? @db.Decimal(8, 4)
  pageMappingVersion String?
  requestKey String @unique
  @@index([dailyStatusId, createdAt])
}
model Assignment {
  autoMemorizationStatusId String?
  memorizationManual Boolean @default(false)
  autoReviewStatusId String?
  reviewManual Boolean @default(false)
  id String @id @default(cuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  dueDate DateTime @db.Date
  memorization Json?
  review Json?
  note String @default("")
  imageName String @default("")
  carriedFromId String?
  carriedFrom Assignment? @relation("Carry", fields: [carriedFromId], references: [id])
  carriedTo Assignment[] @relation("Carry")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([enrollmentId, dueDate])
}

// Separate identities and sessions prevent teacher codes granting supervisory access.
model Supervisor {
  codeLookup String? @unique
  codeHash String?
  id String @id @default(cuid())
  username String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  sessions SupervisorSession[]
}
model SupervisorSession {
  id String @id
  supervisorId String
  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model MemorizationSequence {
  id String @id @default(cuid())
  enrollmentId String @unique
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  startSurah Int
  startAyah Int
  initialDirection RangeDirection?
  anchorEntryId String?
  anchorMastered Boolean @default(false)
  createdAt DateTime @default(now())
}

model SupervisorCorrection {
 id String @id @default(cuid())
 supervisorId String
 halqaId String
 enrollmentId String
 date DateTime @db.Date
 action String
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([enrollmentId, date, createdAt])
}

model StudentTransfer {
 sequence Int @unique @default(autoincrement())
 id String @id @default(cuid())
 studentId String
 sourceEnrollmentId String
 targetEnrollmentId String
 sourceHalqaId String
 targetHalqaId String
 supervisorId String
 requestKey String @unique
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([studentId, createdAt])
}
