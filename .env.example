DATABASE_URL="postgresql://halqa:halqa@localhost:5432/halqa?schema=public"
APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Istanbul"
NEXT_PUBLIC_ACADEMY_NAME=""
# Generate a random secret of at least 32 characters. Never change it without rotating teacher codes.
AUTH_SECRET=""
# Required only when seeding; provide a four- or six-digit code. No default production code.
SEED_TEACHER_CODE=""
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"

# Optional: comma-separated demonstration halqa IDs omitted from supervision.
SUPERVISOR_EXCLUDED_HALQA_IDS=""
# Provision supervisors with scripts/create-supervisor.ts and temporary environment variables.
# SUPERVISOR_USERNAME, SUPERVISOR_CODE (8 digits), SUPERVISOR_NAME.
# Never persist the plain code in this file or the repository.
